<Application x:Class="StreamLite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StreamLite.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Themes/Dark.xaml"/>
                <ResourceDictionary>
                    <converters:PlaybackStatusToBoolConverter x:Key="PlaybackStatusToBool"/>

                    <DataTemplate x:Key="HomeTemplate">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ScrollBarStyle}">
                            <StackPanel Margin="32">
                                <Border Height="140" CornerRadius="16" Margin="0,0,0,32"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1A1A1A" Offset="0"/>
                                            <GradientStop Color="#2A1010" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Margin="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16"
                                                Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="28"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <TextBlock Text="Welcome to StreamLite" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock Text="Drag &amp; drop media or browse your library" FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <WrapPanel>
                                    <Button Width="180" Height="120" Style="{StaticResource CardButton}"
                                            Command="{Binding NavigateCommand}" CommandParameter="library">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="28"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Browse Library" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="180" Height="120" Style="{StaticResource CardButton}"
                                            Command="{Binding NavigateCommand}" CommandParameter="playlists">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE142;" FontSize="28"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Open Playlist" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="180" Height="120" Style="{StaticResource CardButton}"
                                            Command="{Binding NavigateCommand}" CommandParameter="equalizer">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEAD5;" FontSize="28"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Audio Equalizer" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>

                    <DataTemplate x:Key="LibraryTemplate">
                        <Grid Margin="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Library" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                            <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="Your library is empty. Add media to get started."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </Border>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="PlaylistTemplate">
                        <Grid Margin="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Playlists" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                            <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="No playlists yet" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            </Border>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="EqualizerTemplate">
                        <Grid Margin="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Equalizer" FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>
                            <Border Grid.Row="1" Height="200" CornerRadius="16" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid Margin="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="80" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="1" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="60" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="2" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="90" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="3" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="70" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="4" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="100" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="5" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="50" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="6" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="85" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="7" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="65" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="8" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="75" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                    <Border Grid.Column="9" Width="24" Height="120" CornerRadius="4" Background="#333" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <Border Height="45" CornerRadius="4" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="SettingsTemplate">
                        <Grid Margin="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>
                            <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24">
                                <StackPanel>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Hardware Acceleration" FontSize="13"/>
                                            <TextBlock Text="Use GPU for video decoding" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="40" Height="20" CornerRadius="10" Background="#333" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Remember Position" FontSize="13"/>
                                            <TextBlock Text="Resume from where you left off" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="40" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                                            <Border Width="18" Height="18" CornerRadius="9" Background="White" HorizontalAlignment="Right" Margin="0,0,1,0"/>
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Dark Theme" FontSize="13"/>
                                            <TextBlock Text="Application color scheme" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="40" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                                            <Border Width="18" Height="18" CornerRadius="9" Background="White" HorizontalAlignment="Right" Margin="0,0,1,0"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
