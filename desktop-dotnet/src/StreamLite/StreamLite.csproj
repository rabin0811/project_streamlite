<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>StreamLite</AssemblyName>
    <RootNamespace>StreamLite</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>StreamLite Desktop</AssemblyTitle>
    <Description>A fast, lightweight desktop media player with Fluent Design</Description>
    <Company>StreamLite</Company>
    <Product>StreamLite Desktop</Product>
    <Copyright>Copyright © 2026 StreamLite</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM + DI -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />

    <!-- Media Engine -->
    <PackageReference Include="LibVLCSharp.WPF" Version="3.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.*" />

    <!-- Database -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <PackageReference Include="Dapper" Version="2.*" />

    <!-- Metadata -->
    <PackageReference Include="TagLibSharp" Version="2.*" />

    <!-- Thumbnail generation -->
    <PackageReference Include="System.Drawing.Common" Version="8.*" />

    <!-- Folder dialog -->
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="3.*" />
  </ItemGroup>

</Project>
