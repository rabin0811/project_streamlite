<Window x:Class="StreamLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StreamLite.ViewModels"
        xmlns:converters="clr-namespace:StreamLite.Converters"
        xmlns:helpers="clr-namespace:StreamLite.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="StreamLite"
        MinWidth="900" MinHeight="600"
        Width="1280" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13"
        helpers:DragBehavior.EnableDrag="True"
        helpers:DropFileBehavior.EnableDrop="True"
        helpers:DropFileBehavior.DropCommand="{Binding DropFilesCommand}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:FilePathToNameConverter x:Key="PathToName"/>
        <converters:MediaTypeToIconConverter x:Key="MediaTypeIcon"/>
        <converters:TimeSpanToStringConverter x:Key="TimeToString"/>
        <converters:FileSizeConverter x:Key="FileSizeConv"/>
        <converters:ImagePathConverter x:Key="ImagePath"/>
        <converters:PlaybackStatusToBoolConverter x:Key="PlaybackStatusToBool"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:BoolToPlayIconConverter x:Key="BoolToPlayIcon"/>
        <converters:BoolToVolumeIconConverter x:Key="BoolToVolumeIcon"/>
    </Window.Resources>

    <Border CornerRadius="0" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="StreamLite" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Opacity="0.8"/>

                    <!-- Drag region -->
                    <Border Grid.Column="1" Background="Transparent" helpers:DragBehavior.EnableDrag="True"/>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button x:Name="MinimizeBtn" Style="{StaticResource GhostButton}" Width="36" Height="28"
                                Click="MinimizeClick" FontFamily="Segoe MDL2 Assets" Content="&#xE921;" FontSize="8"
                                ToolTip="Minimize"/>
                        <Button x:Name="MaximizeBtn" Style="{StaticResource GhostButton}" Width="36" Height="28"
                                Click="MaximizeClick" FontFamily="Segoe MDL2 Assets" Content="&#xE922;" FontSize="8"
                                ToolTip="Maximize"/>
                        <Button x:Name="CloseBtn" Style="{StaticResource GhostButton}" Width="36" Height="28" Margin="4,0,0,0"
                                Click="CloseClick" FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" FontSize="8"
                                ToolTip="Close">
                            <Button.Resources>
                                <Style TargetType="Border" x:Key="CloseHover">
                                    <Setter Property="Background" Value="#E53935"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,12,0,0">
                            <Button x:Name="NavHome" ToolTip="Home" Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="home">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Home" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavLibrary" ToolTip="Library" Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="library">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Library" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavPlaylists" ToolTip="Playlists" Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="playlists">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE142;" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Lists" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavEqualizer" ToolTip="Equalizer" Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="equalizer">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEAD5;" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Audio" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavSettings" ToolTip="Settings" Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateCommand}" CommandParameter="settings">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="22" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Settings" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0.7"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                    <Grid>
                        <ContentControl x:Name="ContentArea"/>

                        <!-- Player Bar at bottom -->
                        <Border x:Name="PlayerBar" VerticalAlignment="Bottom" Height="72"
                                Background="#E6141414" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0" 
                                Visibility="{Binding IsPlayerVisible, Converter={StaticResource BoolToVis}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" BlurRadius="12" ShadowDepth="-2"/>
                            </Border.Effect>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="44" Height="44" CornerRadius="8"
                                            Background="{StaticResource CardBrush}">
                                        <TextBlock Text="{Binding PlayerVM.CurrentMedia.Type, Converter={StaticResource MediaTypeIcon}}"
                                                   FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding PlayerVM.CurrentMedia.DisplayName}" FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                        <TextBlock Text="{Binding PlayerVM.CurrentMedia.FilePath, Converter={StaticResource PathToName}}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <Button Style="{StaticResource GhostButton}" Width="32" Height="32"
                                                Command="{Binding PlayerVM.SeekRelativeCommand}" CommandParameter="-10"
                                                ToolTip="-10s">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDB5;" FontSize="12"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Width="40" Height="40" Margin="8,0"
                                                Command="{Binding PlayerVM.TogglePlayCommand}" ToolTip="Play/Pause">
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentBrush}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Foreground="White"
                                                           Text="{Binding PlayerVM.IsPlaying, Converter={StaticResource BoolToPlayIcon}}" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Width="32" Height="32"
                                                Command="{Binding PlayerVM.SeekRelativeCommand}" CommandParameter="10"
                                                ToolTip="+10s">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDB4;" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PlayerVM.CurrentPosition}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Slider Width="320" Minimum="0" Maximum="100" Value="{Binding PlayerVM.PositionPercent}"
                                                VerticalAlignment="Center" Style="{StaticResource SeekSliderStyle}" Margin="10,0"/>
                                        <TextBlock Text="{Binding PlayerVM.TotalDuration}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding PlayerVM.ToggleMuteCommand}" ToolTip="Mute">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="{Binding PlayerVM.IsMuted, Converter={StaticResource BoolToVolumeIcon}}" FontSize="16"/>
                                    </Button>
                                    <Slider Width="80" Minimum="0" Maximum="1" Value="{Binding PlayerVM.Volume}"
                                            VerticalAlignment="Center" Margin="8,0,16,0"/>
                                    <Button Style="{StaticResource GhostButton}" Command="{Binding PlayerVM.ToggleFullScreenCommand}" ToolTip="Fullscreen">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
