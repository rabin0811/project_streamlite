<UserControl x:Class="StreamLite.Views.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:StreamLite.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:FilePathToNameConverter x:Key="PathToName"/>
    </UserControl.Resources>
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource HeadingText}">Library</TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource AccentButton}" Command="{Binding LibraryVM.AddFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+"/>
                        <TextBlock Text="Add Folder"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernButton}" Command="{Binding OpenFilesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Open File"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search & Filter -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LibraryVM.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton GroupName="Filter" IsChecked="True" Style="{StaticResource ChipStyle}" Content="All"
                                 Command="{Binding LibraryVM.FilterCommand}" CommandParameter="Unknown"/>
                    <RadioButton GroupName="Filter" Style="{StaticResource ChipStyle}" Content="Video"
                                 Command="{Binding LibraryVM.FilterCommand}" CommandParameter="Video"/>
                    <RadioButton GroupName="Filter" Style="{StaticResource ChipStyle}" Content="Audio"
                                 Command="{Binding LibraryVM.FilterCommand}" CommandParameter="Audio"/>
                    <RadioButton GroupName="Filter" Style="{StaticResource ChipStyle}" Content="Image"
                                 Command="{Binding LibraryVM.FilterCommand}" CommandParameter="Image"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Folder List -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" MaxHeight="120" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding LibraryVM.Folders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" 
                                           Foreground="{StaticResource AccentBrush}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}" MaxWidth="200"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" 
                                        Command="{Binding DataContext.LibraryVM.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Media Grid -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding LibraryVM.MediaItems}" 
                              Visibility="{Binding LibraryVM.IsGridView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Width="160" Margin="0,0,12,12" Cursor="Hand">
                                <StackPanel>
                                    <Border Height="90" Background="{StaticResource ControlBrush}" CornerRadius="12,12,0,0">
                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                                   Foreground="{StaticResource TextDisabledBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DurationFormatted}" Style="{StaticResource CaptionText}"/>
                                            <TextBlock Text="{Binding FileSizeFormatted}" Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,24,0,0">
                    <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,12">Favorites</TextBlock>
                    <ItemsControl ItemsSource="{Binding LibraryVM.FavoriteItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" Width="160" Margin="0,0,12,12" Cursor="Hand">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                   Foreground="{StaticResource AccentSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DurationFormatted}" Style="{StaticResource CaptionText}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,24,0,0">
                    <TextBlock Style="{StaticResource SubheadingText}" Margin="0,0,0,12">Resume Playback</TextBlock>
                    <ItemsControl ItemsSource="{Binding LibraryVM.ResumeCandidates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" Padding="12,8" Margin="0,0,8,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEDB3;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding ResumePosition, StringFormat='Resume at {0:F0}s'}" 
                                                       Style="{StaticResource CaptionText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


