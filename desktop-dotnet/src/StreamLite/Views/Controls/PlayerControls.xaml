<UserControl x:Class="StreamLite.Views.Controls.PlayerControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="800">
    <Border Background="{StaticResource GlassBrush}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Seek Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PlayerVM.CurrentPosition}" 
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PlayerVM.PositionPercent}"
                        Style="{StaticResource SeekSliderStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding PlayerVM.TotalDuration}" 
                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <!-- Controls -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding PlayerVM.SeekRelativeCommand}" CommandParameter="-10">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDB5;" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource GhostButton}" Width="40" Height="40"
                        Command="{Binding PlayerVM.TogglePlayCommand}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Text="{Binding PlayerVM.IsPlaying, Converter={StaticResource BoolToPlayIcon}}"/>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding PlayerVM.SeekRelativeCommand}" CommandParameter="10">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDB4;" FontSize="16"/>
                </Button>

                <Separator Style="{StaticResource SeparatorStyle}" Margin="8,0"/>

                <Button Style="{StaticResource GhostButton}" Command="{Binding PlayerVM.ToggleMuteCommand}" ToolTip="Mute">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Text="{Binding PlayerVM.IsMuted, Converter={StaticResource BoolToVolumeIcon}}"/>
                </Button>
                <Slider Width="80" Minimum="0" Maximum="1" Value="{Binding PlayerVM.Volume}"
                        VerticalAlignment="Center" Margin="4,0"/>

                <Separator Style="{StaticResource SeparatorStyle}" Margin="8,0"/>

                <TextBlock Text="{Binding PlayerVM.PlaybackRate, StringFormat='{}{0:F2}x'}" FontSize="12"
                           VerticalAlignment="Center" Margin="4,0"/>
                <Button Style="{StaticResource GhostButton}" Command="{Binding PlayerVM.FrameStepCommand}" ToolTip="Frame Step">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE301;" FontSize="14"/>
                </Button>
                <Button Style="{StaticResource GhostButton}" ToolTip="Fullscreen">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE740;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>


